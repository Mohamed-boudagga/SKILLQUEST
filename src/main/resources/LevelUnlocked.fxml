<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" 
            fx:controller="controllers.LevelUnlockedController" 
            style="-fx-background-color: linear-gradient(to bottom right, #F3E5F5, #E1BEE7); -fx-background-radius: 30; -fx-border-radius: 30; -fx-border-color: #CE93D8; -fx-border-width: 2;">
    <children>
        <VBox alignment="CENTER" spacing="20.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <HBox alignment="CENTER" spacing="15.0">
                    <children>
                        <Label text="✨" style="-fx-font-size: 30;" />
                        <Label text="Félicitations !" style="-fx-text-fill: #6A1B9A; -fx-font-size: 38; -fx-font-weight: bold; -fx-font-family: 'System';" />
                        <Label text="✨" style="-fx-font-size: 30;" />
                    </children>
                </HBox>
                
                <VBox alignment="CENTER" spacing="10.0">
                    <children>
                        <Label text="🌟 NOUS SOMMES FIERS DE TOI ! 🌟" style="-fx-text-fill: #7B1FA2; -fx-font-size: 18; -fx-font-weight: bold; -fx-letter-spacing: 2;" />
                        <Label fx:id="lbMessage" text="Le niveau 2 est maintenant accessible" 
                               style="-fx-text-fill: #4A148C; -fx-font-size: 16; -fx-background-color: white; -fx-padding: 10 30; -fx-background-radius: 25; -fx-effect: dropshadow(three-pass-box, rgba(206,147,216,0.5), 10, 0, 0, 0);" 
                               textAlignment="CENTER" wrapText="true" />
                    </children>
                </VBox>
                
                <Label text="🎗️ Une nouvelle étape franchie avec succès 🎗️" style="-fx-text-fill: #6A1B9A; -fx-font-size: 14; -fx-font-style: italic;" />
                
                <Button text="OBTENIR MON CERTIFICAT 🏆" onAction="#closeWindow" 
                        style="-fx-background-color: linear-gradient(to right, #9C27B0, #673AB7); -fx-text-fill: white; -fx-font-size: 20; -fx-font-weight: bold; -fx-padding: 15 50; -fx-background-radius: 30; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(103,58,183,0.4), 15, 0, 0, 0);" />
            </children>
            <padding>
                <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
            </padding>
        </VBox>
    </children>
</AnchorPane>
