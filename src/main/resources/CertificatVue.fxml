<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="700.0" prefWidth="900.0"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.CertificatVueController"
            style="-fx-background-color: #f5f6fa;">
    <children>
        <!-- Bordure du certificat -->
        <VBox alignment="CENTER" spacing="20.0" AnchorPane.bottomAnchor="40.0" AnchorPane.leftAnchor="40.0" AnchorPane.rightAnchor="40.0" AnchorPane.topAnchor="60.0"
              style="-fx-background-color: white; -fx-border-color: #dcdde1; -fx-border-width: 10; -fx-padding: 50;">
            <children>
                <Label text="CONGRATULATIONS!" style="-fx-font-size: 40; -fx-font-weight: bold; -fx-text-fill: #27ae60;" />
                <Label text="CERTIFICATE OF ACHIEVEMENT" style="-fx-font-size: 20; -fx-text-fill: #7f8c8d; -fx-letter-spacing: 5;" />
                
                <Separator maxWidth="500.0" />

                <Label text="This is to certify that" style="-fx-font-style: italic; -fx-font-size: 18; -fx-text-fill: #2c3e50;" />
                
                <Label fx:id="lbStudentName" text="STUDENT NAME" style="-fx-font-size: 36; -fx-font-weight: bold; -fx-text-fill: #2980b9;" />
                
                <Label text="has successfully completed the requirements for" style="-fx-font-size: 16; -fx-text-fill: #2c3e50;" />
                
                <Label fx:id="lbCertTitle" text="CERTIFICATION TITLE" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #c0392b;" />
                
                <Text fx:id="txtDescription" text="Description of the certification goes here..." 
                      wrappingWidth="600.0" textAlignment="CENTER" style="-fx-font-size: 14; -fx-fill: #7f8c8d;" />

                <HBox alignment="CENTER" spacing="100.0">
                    <VBox alignment="CENTER">
                        <Label text="Level" style="-fx-text-fill: #95a5a6;" />
                        <Label fx:id="lbLevel" text="1" style="-fx-font-weight: bold; -fx-font-size: 18;" />
                    </VBox>
                    <VBox alignment="CENTER">
                        <Label text="Date" style="-fx-text-fill: #95a5a6;" />
                        <Label fx:id="lbDate" text="2026-05-06" style="-fx-font-weight: bold; -fx-font-size: 18;" />
                    </VBox>
                </HBox>
            </children>
        </VBox>

        <!-- Bouton de retour déporté en haut à gauche -->
        <Button text="← RETOUR" onAction="#goHome" 
                AnchorPane.topAnchor="15.0" AnchorPane.leftAnchor="15.0"
                style="-fx-background-color: transparent; -fx-text-fill: #34495e; -fx-font-weight: bold; -fx-border-color: #34495e; -fx-border-radius: 5; -fx-cursor: hand;" />
    </children>
</AnchorPane>
