<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="controllers.GestionQuestionsController" style="-fx-background-color: #f4f4f9;">
    <children>
        <SplitPane dividerPositions="0.4" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <items>
                <!-- Formulaire (Gauche) -->
                <VBox spacing="10.0" style="-fx-background-color: white; -fx-padding: 15;">
                    <Button text="← Retour" onAction="#fermerFenetre" style="-fx-background-color: #7f8c8d; -fx-text-fill: white;" />
                    <Label text="Ajouter/Modifier Question" style="-fx-font-size: 16; -fx-font-weight: bold;" />
                    <Separator />
                    
                    <Label text="Texte de la question" />
                    <TextArea fx:id="taQuestion" prefHeight="80.0" wrapText="true" />

                    <Label text="Options (une par ligne - 4 max)" />
                    <TextArea fx:id="taOptions" prefHeight="100.0" promptText="Option 1&#10;Option 2&#10;Option 3&#10;Option 4" />

                    <Label text="Index de la bonne réponse (0-3)" />
                    <TextField fx:id="tfCorrectIndex" promptText="Ex: 0" />

                    <Label text="Points" />
                    <TextField fx:id="tfPoints" text="25" />

                    <HBox spacing="10.0" alignment="CENTER">
                        <Button text="Ajouter" onAction="#ajouterQuestion" maxWidth="Infinity" HBox.hgrow="ALWAYS" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold;" />
                        <Button text="Modifier" onAction="#modifierQuestion" maxWidth="Infinity" HBox.hgrow="ALWAYS" style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-font-weight: bold;" />
                    </HBox>
                    <Button text="Supprimer" onAction="#supprimerQuestion" maxWidth="Infinity" style="-fx-background-color: #c0392b; -fx-text-fill: white; -fx-font-weight: bold;" />
                    <Button text="Vider" onAction="#clearFields" maxWidth="Infinity" />
                </VBox>

                <!-- Liste (Droite) -->
                <VBox spacing="10.0" style="-fx-padding: 10;">
                    <Label fx:id="lbExamTitle" text="Questions pour l'examen" style="-fx-font-size: 16; -fx-font-weight: bold;" />
                    <TableView fx:id="tvQuestions" VBox.vgrow="ALWAYS" onMouseClicked="#handleTableSelection">
                        <columns>
                            <TableColumn fx:id="colText" text="Question" prefWidth="300" />
                            <TableColumn fx:id="colCorrect" text="Index Correct" prefWidth="80" />
                            <TableColumn fx:id="colPoints" text="Points" prefWidth="60" />
                        </columns>
                    </TableView>
                    <Label fx:id="lbStatus" text="Prêt" style="-fx-text-fill: gray;" />
                </VBox>
            </items>
        </SplitPane>
    </children>
</AnchorPane>
