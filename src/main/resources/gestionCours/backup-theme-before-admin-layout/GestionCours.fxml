<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.controllers.gestionCours.GestionCoursController"
            stylesheets="@style.css"
            styleClass="app-root">

    <left>
        <VBox prefWidth="230" spacing="18" styleClass="sidebar">
            <padding>
                <Insets top="32" right="22" bottom="24" left="22"/>
            </padding>

            <Label text="SkillQuest" styleClass="brand-title"/>
            <Label text="Bonjour, Sarra !" styleClass="user-greeting"/>

            <VBox spacing="10" styleClass="nav-list">
                <Button text="Mon Profil" maxWidth="Infinity" styleClass="nav-button"/>
                <Button text="Mes Cours" maxWidth="Infinity" styleClass="nav-button-active"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>
            <Button text="Deconnexion" maxWidth="Infinity" styleClass="logout-button"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="18" styleClass="content">
            <HBox spacing="12" alignment="CENTER_LEFT" styleClass="page-header">
                <Label text="Mes Cours Disponibles" styleClass="page-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Ajouter cours"
                        onAction="#goToAddCours"
                        styleClass="btn-add"/>
            </HBox>

            <TableView fx:id="tableCours" VBox.vgrow="ALWAYS" styleClass="table">
                <columns>
                    <TableColumn fx:id="colTitre" text="Titre" prefWidth="230"/>
                    <TableColumn fx:id="colDescription" text="Description" prefWidth="430"/>
                    <TableColumn fx:id="colNiveau" text="Niveau" prefWidth="130"/>
                    <TableColumn fx:id="coldateDeCreation" text="Date de creation" prefWidth="160"/>
                    <TableColumn fx:id="colAction" text="Action" prefWidth="140"/>
                </columns>
            </TableView>

            <Pagination fx:id="pagination" styleClass="pagination"/>
        </VBox>
    </center>
</BorderPane>
