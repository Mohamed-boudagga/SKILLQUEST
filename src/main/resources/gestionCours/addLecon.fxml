<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>


<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="tn.esprit.controllers.gestionCours.AddLeconController"
            prefHeight="400.0" prefWidth="600.0">

    <center>
        <VBox spacing="18" styleClass="content">
            <Label text="Ajouter un Cours" styleClass="page-title"/>

            <VBox spacing="14" maxWidth="620" styleClass="form-panel">
                <TextField fx:id="txtTitre" promptText="Titre du cours" styleClass="form-input"/>
                <TextArea fx:id="txtDescription" promptText="Description du cours" prefHeight="150" styleClass="form-input"/>
                <TextArea fx:id="txtContenue" promptText="Fichiers, URL videos, documents..." prefHeight="120" styleClass="form-input"/>
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <Button text="Choisir fichier" onAction="#choisirFichier" styleClass="secondary-button"/>
                    <Label text="Le chemin sera stocke dans la base" styleClass="hint-label"/>
                </HBox>
                <ComboBox fx:id="comboNiveau" promptText="Niveau entre 1 et 6" maxWidth="Infinity" styleClass="form-input"/>

                <Label fx:id="lblError" styleClass="error-label"/>

                <HBox spacing="12" alignment="CENTER_RIGHT">
                    <Button text="Annuler" onAction="#annuler" styleClass="secondary-button"/>
                    <Button text="Ajouter" onAction="#ajouterLecon" styleClass="btn-add"/>
                </HBox>
            </VBox>
        </VBox>
    </center>

        </BorderPane>
