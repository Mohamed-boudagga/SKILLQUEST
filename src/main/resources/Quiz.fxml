<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="controllers.QuizController"
      prefHeight="600.0" prefWidth="800.0"
      spacing="20"
      style="-fx-background-color: #0d0d2b; -fx-padding: 40;">

    <HBox alignment="CENTER_LEFT" spacing="20">
        <Label fx:id="lbTimer" text="00:00" style="-fx-text-fill: #00ffff; -fx-font-size: 24; -fx-font-weight: bold; -fx-border-color: #00ffff; -fx-border-width: 2; -fx-padding: 10; -fx-border-radius: 10;"/>
        <Region HBox.hgrow="ALWAYS" />
        <Label fx:id="lbProgress" text="Question 1/5" style="-fx-text-fill: #ff00ff; -fx-font-size: 20; -fx-font-weight: bold;"/>
    </HBox>

    <ProgressBar fx:id="pbProgress" prefWidth="800" progress="0.2" style="-fx-accent: #ff00ff;"/>

    <VBox alignment="CENTER" spacing="30" VBox.vgrow="ALWAYS" style="-fx-background-color: #1a1a4a; -fx-background-radius: 20; -fx-border-color: #00ffff; -fx-border-width: 3; -fx-padding: 30;">
        <Label fx:id="lbQuestion" text="Chargement de la question..." wrapText="true" textAlignment="CENTER"
               style="-fx-text-fill: white; -fx-font-size: 26; -fx-font-weight: bold;"/>

        <VBox fx:id="vbOptions" spacing="15" alignment="CENTER">
            <!-- Options will be added here dynamically -->
        </VBox>
    </VBox>

    <HBox alignment="CENTER" spacing="20">
        <Button fx:id="btnNext" text="SUIVANT" onAction="#handleNext"
                style="-fx-background-color: #ff00ff; -fx-text-fill: white; -fx-font-size: 18; -fx-font-weight: bold; -fx-padding: 10 40; -fx-background-radius: 30; -fx-cursor: hand;"/>
        <Button fx:id="btnFinish" text="TERMINER" onAction="#handleFinish" visible="false"
                style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 18; -fx-font-weight: bold; -fx-padding: 10 40; -fx-background-radius: 30; -fx-cursor: hand;"/>
    </HBox>

</VBox>
