<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="600.0" prefWidth="900.0" spacing="20.0" style="-fx-background-color: #1b2a4e; -fx-padding: 30;" stylesheets="@../style/style.css" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.QuestionManagerController">
   <children>
      <Label style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #f45b69;" text="Gestion des Questions" />
      
      <HBox spacing="15.0" style="-fx-background-color: rgba(255,255,255,0.05); -fx-padding: 20; -fx-background-radius: 10;">
         <children>
            <VBox spacing="10.0" HBox.hgrow="ALWAYS">
               <children>
                  <TextField fx:id="txtQuestion" promptText="Saisir la question..." />
                  <HBox spacing="10.0">
                     <children>
                        <TextField fx:id="txtOpt1" promptText="Option 1" HBox.hgrow="ALWAYS" />
                        <TextField fx:id="txtOpt2" promptText="Option 2" HBox.hgrow="ALWAYS" />
                        <TextField fx:id="txtOpt3" promptText="Option 3" HBox.hgrow="ALWAYS" />
                     </children>
                  </HBox>
                  <TextField fx:id="txtCorrect" promptText="Reponse Correcte (doit etre identique a une option)" />
               </children>
            </VBox>
            <Button fx:id="btnAdd" onAction="#handleAddQuestion" prefHeight="100.0" prefWidth="120.0" style="-fx-background-color: #f45b69; -fx-text-fill: white; -fx-font-weight: bold;" text="AJOUTER" />
         </children>
      </HBox>
      
      <TableView fx:id="tableQuestions" VBox.vgrow="ALWAYS" style="-fx-background-radius: 10;">
        <columns>
          <TableColumn fx:id="colText" prefWidth="400.0" text="QUESTION" />
          <TableColumn fx:id="colActions" prefWidth="150.0" text="ACTIONS" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
      
      <HBox alignment="CENTER_RIGHT">
         <children>
            <Button onAction="#handleBack" style="-fx-background-color: #3a86ff; -fx-text-fill: white;" text="TERMINER" prefWidth="150" />
         </children>
      </HBox>
   </children>
</VBox>
