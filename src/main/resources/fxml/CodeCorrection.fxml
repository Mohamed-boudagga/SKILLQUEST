<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<BorderPane prefWidth="1100" prefHeight="780" style="-fx-background-color: #1b2a4e;" stylesheets="@../style/style.css" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.CodeCorrectionController">
    <top>
        <HBox spacing="20" style="-fx-padding: 15 25; -fx-background-color: #0d1b3e; -fx-border-color: #2d3f6b; -fx-border-width: 0 0 1 0;" alignment="CENTER_LEFT">
            <Button text="RETOUR" onAction="#handleBack" styleClass="btn-danger"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="CORRECTION DE CODE" style="-fx-text-fill: white; -fx-font-size: 22; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Circle fx:id="aiStatus" radius="10" fill="DODGERBLUE"/>
            <Label fx:id="lblScore" text="SCORE: 0" style="-fx-text-fill: #fbbf24; -fx-font-size: 18; -fx-font-weight: bold;"/>
        </HBox>
    </top>

    <center>
        <HBox spacing="0">
            <!-- Zone principale d'edition -->
            <VBox spacing="15" style="-fx-padding: 25;" HBox.hgrow="ALWAYS">
                <!-- Consigne -->
                <VBox spacing="5" style="-fx-background-color: #0d1b3e; -fx-padding: 15; -fx-border-radius: 8; -fx-background-radius: 8; -fx-border-color: #2d3f6b; -fx-border-width: 1;">
                    <Label text="CONSIGNE :" style="-fx-text-fill: #fbbf24; -fx-font-size: 13; -fx-font-weight: bold;"/>
                    <Label fx:id="lblInstructions" text="Chargement..." style="-fx-text-fill: white; -fx-font-size: 16;" wrapText="true"/>
                </VBox>

                <!-- Editeur de code -->
                <VBox spacing="5" VBox.vgrow="ALWAYS">
                    <Label text="VOTRE CODE :" style="-fx-text-fill: #6b82b5; -fx-font-size: 13; -fx-font-weight: bold;"/>
                    <TextArea fx:id="txtEditor" VBox.vgrow="ALWAYS" style="-fx-font-family: 'Consolas'; -fx-font-size: 14;"/>
                </VBox>

                <!-- Correction cachee (affichee sur demande) -->
                <VBox fx:id="panelCorrection" spacing="5" visible="false" managed="false">
                    <Label text="CORRECTION OFFICIELLE :" style="-fx-text-fill: #4ade80; -fx-font-size: 13; -fx-font-weight: bold;"/>
                    <TextArea fx:id="txtCorrection" editable="false" prefHeight="150" style="-fx-font-family: 'Consolas'; -fx-font-size: 13; -fx-control-inner-background: #0a2a1a;"/>
                </VBox>

                <!-- Boutons d'action -->
                <HBox spacing="12" alignment="CENTER_RIGHT">
                    <Button text="VOIR LA CORRECTION" onAction="#handleShowCorrection" styleClass="btn-warn"/>
                    <Button text="RESET" onAction="#handleReset" style="-fx-background-color: transparent; -fx-text-fill: #6b82b5; -fx-border-color: #2d3f6b; -fx-border-radius: 8;"/>
                    <Button text="SOUMETTRE" onAction="#handleSubmit" styleClass="btn-success" style="-fx-font-size: 16;"/>
                </HBox>
            </VBox>

            <!-- Panel IA -->
            <VBox prefWidth="280" spacing="15" style="-fx-background-color: #0a1428; -fx-padding: 20; -fx-border-color: #2d3f6b; -fx-border-width: 0 0 0 1;">
                <Label text="ASSISTANT IA" style="-fx-text-fill: #6b82b5; -fx-font-size: 13; -fx-font-weight: bold;"/>
                <Separator/>
                <TextArea fx:id="txtAiFeedback" editable="false" wrapText="true" VBox.vgrow="ALWAYS" style="-fx-font-size: 13;"/>
            </VBox>
        </HBox>
    </center>
</BorderPane>
