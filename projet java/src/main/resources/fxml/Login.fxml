<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.image.*?>

<AnchorPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.LoginController"
            prefWidth="500" prefHeight="400"
            style="-fx-background-color: #1a1a2e;">

    <!-- Définition du ToggleGroup hors de l'arbre visuel -->
    <fx:define>
        <ToggleGroup fx:id="roleGroup"/>
    </fx:define>

    <VBox alignment="CENTER" spacing="20"
          AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

        <padding><Insets top="40" bottom="40" left="60" right="60"/></padding>

        <!-- Titre -->
        <Label text="SkillQuest"
               style="-fx-font-size:32px; -fx-font-weight:bold; -fx-text-fill:#e94560;"/>
        <Label text="Connexion"
               style="-fx-font-size:16px; -fx-text-fill:#a8a8b3;"/>

        <!-- Email -->
        <TextField fx:id="emailField" promptText="Email"
                   maxWidth="360"
                   style="-fx-background-color:#16213e; -fx-text-fill:white;
                          -fx-prompt-text-fill:#a8a8b3; -fx-background-radius:8;
                          -fx-border-color:#e94560; -fx-border-radius:8; -fx-padding:10;
                          -fx-font-size:14px;"/>

        <!-- Mot de passe avec bouton œil -->
        <StackPane maxWidth="360">
            <PasswordField fx:id="passwordField" promptText="Mot de passe"
                           style="-fx-background-color:#16213e; -fx-text-fill:white;
                                  -fx-prompt-text-fill:#a8a8b3; -fx-background-radius:8;
                                  -fx-border-color:#e94560; -fx-border-radius:8; -fx-padding:10 40 10 10;
                                  -fx-font-size:14px;"/>
            <TextField fx:id="passwordVisibleField" promptText="Mot de passe" visible="false"
                       style="-fx-background-color:#16213e; -fx-text-fill:white;
                              -fx-prompt-text-fill:#a8a8b3; -fx-background-radius:8;
                              -fx-border-color:#e94560; -fx-border-radius:8; -fx-padding:10 40 10 10;
                              -fx-font-size:14px;"/>
            <ToggleButton fx:id="eyeButton" onAction="#togglePassword" text="👁"
                          StackPane.alignment="CENTER_RIGHT"
                          style="-fx-background-color:transparent; -fx-text-fill:#a8a8b3;
                                 -fx-cursor:hand; -fx-font-size:16px; -fx-padding:0 10 0 0;"/>
        </StackPane>

        <!-- Choix du rôle -->
        <HBox alignment="CENTER" spacing="30">
            <RadioButton fx:id="radioEtudiant" text="Étudiant" selected="true"
                         toggleGroup="$roleGroup"
                         style="-fx-text-fill:white; -fx-font-size:13px;"/>
            <RadioButton fx:id="radioAdmin" text="Admin"
                         toggleGroup="$roleGroup"
                         style="-fx-text-fill:white; -fx-font-size:13px;"/>
        </HBox>

        <!-- Captcha Style reCAPTCHA -->
        <HBox alignment="CENTER_LEFT" spacing="15" maxWidth="360"
              style="-fx-background-color: #f9f9f9; -fx-padding: 10; -fx-background-radius: 3;
                     -fx-border-color: #d3d3d3; -fx-border-radius: 3; -fx-border-width: 1;">
            <CheckBox fx:id="captchaCheckBox" style="-fx-cursor: hand; -fx-scale-x: 1.5; -fx-scale-y: 1.5;"/>
            <Label text="Je ne suis pas un robot"
                   style="-fx-text-fill: #555555; -fx-font-size: 14px; -fx-font-family: 'Roboto', 'Arial';"/>
            <Region HBox.hgrow="ALWAYS"/>
            <VBox alignment="CENTER" spacing="2">
                <!-- Simulation du logo reCAPTCHA avec des symboles -->
                <Label text="♻" style="-fx-text-fill: #4A90E2; -fx-font-size: 20px;"/>
                <Label text="reCAPTCHA" style="-fx-text-fill: #555555; -fx-font-size: 8px;"/>
            </VBox>
        </HBox>

        <!-- Message erreur -->
        <Label fx:id="erreurLabel" text=""
               style="-fx-text-fill:#e94560; -fx-font-size:12px;"/>

        <!-- Bouton Connexion -->
        <Button fx:id="btnConnexion" text="Se connecter"
                onAction="#handleConnexion"
                maxWidth="360"
                style="-fx-background-color:#e94560; -fx-text-fill:white;
                       -fx-font-size:15px; -fx-font-weight:bold;
                       -fx-background-radius:8; -fx-cursor:hand;
                       -fx-padding:10 40 10 40;"/>

        <!-- Lien Mot de passe oublié -->
        <Hyperlink text="Mot de passe oublié ?" onAction="#handleMotDePasseOublie"
                   style="-fx-text-fill:#e94560; -fx-font-size:12px;"/>

        <Separator maxWidth="300" style="-fx-opacity: 0.2; -fx-padding: 10 0;"/>

        <!-- Bouton Google -->
        <Button onAction="#handleGoogleLogin" maxWidth="360"
                style="-fx-background-color: white; -fx-text-fill: #444444; 
                       -fx-font-weight: bold; -fx-background-radius: 25; 
                       -fx-border-color: #dddddd; -fx-border-radius: 25; 
                       -fx-cursor: hand; -fx-padding: 8 20;">
            <graphic>
                <HBox alignment="CENTER" spacing="10">
                    <ImageView fitWidth="20" fitHeight="20" preserveRatio="true">
                        <Image url="@../images/google_icon.png"/>
                    </ImageView>
                    <Label text="Se connecter avec Google" style="-fx-text-fill: #444444; -fx-font-weight: bold;"/>
                </HBox>
            </graphic>
        </Button>

        <!-- Lien inscription -->
        <Hyperlink fx:id="lienInscription" text="Pas encore inscrit ? S'inscrire"
                   onAction="#handleInscription"
                   style="-fx-text-fill:#a8a8b3; -fx-font-size:12px;"/>

    </VBox>
</AnchorPane>
