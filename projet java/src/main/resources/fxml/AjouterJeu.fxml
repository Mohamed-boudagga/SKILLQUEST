<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>
<?import javafx.collections.*?>
<?import java.lang.*?>

<AnchorPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.AjouterJeuController"
            prefWidth="460" prefHeight="450"
            style="-fx-background-color:#1a1a2e;">

    <VBox spacing="15" alignment="TOP_CENTER"
          AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

        <padding><Insets top="30" bottom="30" left="50" right="50"/></padding>

        <Label fx:id="titreForm" text="Ajouter un Jeu"
               style="-fx-font-size:22px; -fx-font-weight:bold; -fx-text-fill:#e94560;"/>

        <TextField fx:id="nomField" promptText="Nom du jeu *"
                   style="-fx-background-color:#16213e; -fx-text-fill:white;
                          -fx-prompt-text-fill:#a8a8b3; -fx-background-radius:8;
                          -fx-border-color:#0f3460; -fx-border-radius:8; -fx-padding:10;"/>

        <ComboBox fx:id="typeCombo" promptText="Type de jeu *" maxWidth="Infinity"
                  style="-fx-background-color:#16213e; -fx-text-fill:white;
                         -fx-background-radius:8; -fx-border-color:#0f3460;
                         -fx-border-radius:8; -fx-padding:5;">
            <items>
                <FXCollections fx:factory="observableArrayList">
                    <String fx:value="BATTLE"/>
                    <String fx:value="QUIZ"/>
                </FXCollections>
            </items>
        </ComboBox>

        <TextArea fx:id="descriptionField" promptText="Description"
                  prefRowCount="4" wrapText="true"
                  style="-fx-background-color:#16213e; -fx-text-fill:white;
                         -fx-prompt-text-fill:#a8a8b3; -fx-background-radius:8;
                         -fx-border-color:#0f3460; -fx-border-radius:8; -fx-padding:10;"/>

        <Label fx:id="messageLabel" text="" wrapText="true"
               style="-fx-font-size:12px; -fx-text-fill:#e94560;" maxWidth="360"/>

        <HBox spacing="15" alignment="CENTER">
            <Button text="Annuler" onAction="#handleAnnuler"
                    style="-fx-background-color:transparent; -fx-text-fill:#a8a8b3;
                           -fx-border-color:#a8a8b3; -fx-border-radius:6;
                           -fx-background-radius:6; -fx-padding:10 25; -fx-cursor:hand;"/>
            <Button fx:id="btnSauvegarder" text="Sauvegarder"
                    onAction="#handleSauvegarder"
                    style="-fx-background-color:#e94560; -fx-text-fill:white;
                           -fx-font-weight:bold; -fx-background-radius:6;
                           -fx-padding:10 25; -fx-cursor:hand;"/>
        </HBox>

    </VBox>
</AnchorPane>
