<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefWidth="900" prefHeight="650" style="-fx-background-color: #1a1a2e;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.gestionJeux.QuizController">
    <top>
        <HBox spacing="20" style="-fx-padding: 15; -fx-background-color: #16213e;" alignment="CENTER_LEFT">
            <Button text="QUITTER" onAction="#handleBack"
                    style="-fx-background-color: #e94560; -fx-text-fill: white; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblScore" text="SCORE: 0" style="-fx-text-fill: #fbbf24; -fx-font-size: 18; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="30" alignment="CENTER" style="-fx-padding: 30; -fx-background-color: #1a1a2e;">
            <Label fx:id="lblQuestion" text="..." wrapText="true" textAlignment="CENTER"
                   style="-fx-text-fill: white; -fx-font-size: 22;"/>
            <HBox spacing="10" alignment="CENTER">
                <Label fx:id="lblTimer" text="15s" style="-fx-text-fill: #e94560; -fx-font-size: 18; -fx-font-weight: bold;"/>
                <ProgressBar fx:id="progressTimer" prefWidth="300" progress="1.0"
                             style="-fx-accent: #e94560;"/>
            </HBox>
            <VBox spacing="15" alignment="CENTER">
                <Button fx:id="btnOpt1" onAction="#handleAnswer" prefWidth="400"
                        style="-fx-background-color: #16213e; -fx-text-fill: white; -fx-border-color: #0f3460; -fx-border-radius: 8; -fx-padding: 12;"/>
                <Button fx:id="btnOpt2" onAction="#handleAnswer" prefWidth="400"
                        style="-fx-background-color: #16213e; -fx-text-fill: white; -fx-border-color: #0f3460; -fx-border-radius: 8; -fx-padding: 12;"/>
                <Button fx:id="btnOpt3" onAction="#handleAnswer" prefWidth="400"
                        style="-fx-background-color: #16213e; -fx-text-fill: white; -fx-border-color: #0f3460; -fx-border-radius: 8; -fx-padding: 12;"/>
            </VBox>
        </VBox>
    </center>
</BorderPane>
