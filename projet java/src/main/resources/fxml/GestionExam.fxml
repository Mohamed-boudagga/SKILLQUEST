<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="700.0" prefWidth="1000.0"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.gestionTestCertif.GestionExamController"
            style="-fx-background-color: #1a1a2e;">
    <SplitPane dividerPositions="0.35"
               AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
               AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <VBox spacing="15.0" style="-fx-background-color: #16213e; -fx-padding: 20;">
            <Button text="← FERMER" onAction="#retourSelection"
                    style="-fx-background-color: transparent; -fx-text-fill: #e94560; -fx-font-weight: bold; -fx-border-color: #e94560; -fx-border-radius: 5; -fx-cursor: hand;"/>
            <Label text="Gestion des Examens"
                   style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Separator/>
            <Label text="Nom de l'examen" style="-fx-text-fill: #a8a8b3;"/>
            <TextField fx:id="tfNom" promptText="Ex: Java Basics"
                       style="-fx-background-color: #0f3460; -fx-text-fill: white;"/>
            <Label text="Niveau" style="-fx-text-fill: #a8a8b3;"/>
            <TextField fx:id="tfLevel" promptText="Ex: 1"
                       style="-fx-background-color: #0f3460; -fx-text-fill: white;"/>
            <Label text="Durée (minutes)" style="-fx-text-fill: #a8a8b3;"/>
            <TextField fx:id="tfDuree" promptText="Ex: 60"
                       style="-fx-background-color: #0f3460; -fx-text-fill: white;"/>
            <Separator/>
            <Button fx:id="btnGererQuestions" text="Gérer les questions" onAction="#ouvrirGererQuestions"
                    maxWidth="Infinity"
                    style="-fx-background-color: #0f3460; -fx-text-fill: white; -fx-font-weight: bold;"
                    visible="false"/>
            <VBox spacing="10.0" alignment="CENTER">
                <Button text="Ajouter" onAction="#ajouterExam" maxWidth="Infinity"
                        style="-fx-background-color: #4ade80; -fx-text-fill: #1a1a2e; -fx-font-weight: bold;"/>
                <HBox spacing="10.0">
                    <Button text="Modifier" onAction="#modifierExam" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                            style="-fx-background-color: #0f3460; -fx-text-fill: white; -fx-font-weight: bold;"/>
                    <Button text="Supprimer" onAction="#supprimerExam" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                            style="-fx-background-color: #e94560; -fx-text-fill: white; -fx-font-weight: bold;"/>
                </HBox>
                <Button text="Vider" onAction="#clearFields" maxWidth="Infinity"
                        style="-fx-background-color: #a8a8b3; -fx-text-fill: #1a1a2e;"/>
            </VBox>
        </VBox>
        <VBox spacing="10.0" style="-fx-background-color: #1a1a2e; -fx-padding: 10;">
            <Label text="Liste des Examens" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <TableView fx:id="tvExams" VBox.vgrow="ALWAYS" onMouseClicked="#handleTableSelection"
                       style="-fx-background-color: #16213e;">
                <columns>
                    <TableColumn fx:id="colNom" text="Nom" prefWidth="250"/>
                    <TableColumn fx:id="colLevel" text="Niveau" prefWidth="100"/>
                    <TableColumn fx:id="colDuree" text="Durée (min)" prefWidth="100"/>
                </columns>
            </TableView>
            <Label fx:id="lbStatus" text="Prêt" style="-fx-text-fill: #a8a8b3;"/>
        </VBox>
    </SplitPane>
</AnchorPane>
