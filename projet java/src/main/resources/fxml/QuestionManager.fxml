<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="600.0" prefWidth="900.0" spacing="20.0"
      style="-fx-background-color: #1a1a2e; -fx-padding: 30;"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.gestionJeux.QuestionManagerController">
   <Label style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #e94560;" text="Gestion des Questions"/>

   <HBox spacing="15.0" style="-fx-background-color: #16213e; -fx-padding: 20; -fx-background-radius: 10;">
      <VBox spacing="10.0" HBox.hgrow="ALWAYS">
         <TextField fx:id="txtQuestion" promptText="Saisir la question..."
                    style="-fx-background-color: #0f3460; -fx-text-fill: white;"/>
         <HBox spacing="10.0">
            <TextField fx:id="txtOpt1" promptText="Option 1" HBox.hgrow="ALWAYS"
                       style="-fx-background-color: #0f3460; -fx-text-fill: white;"/>
            <TextField fx:id="txtOpt2" promptText="Option 2" HBox.hgrow="ALWAYS"
                       style="-fx-background-color: #0f3460; -fx-text-fill: white;"/>
            <TextField fx:id="txtOpt3" promptText="Option 3" HBox.hgrow="ALWAYS"
                       style="-fx-background-color: #0f3460; -fx-text-fill: white;"/>
         </HBox>
         <TextField fx:id="txtCorrect" promptText="Réponse Correcte (identique à une option)"
                    style="-fx-background-color: #0f3460; -fx-text-fill: white;"/>
      </VBox>
      <Button fx:id="btnAdd" onAction="#handleAddQuestion" prefHeight="100.0" prefWidth="120.0"
              style="-fx-background-color: #e94560; -fx-text-fill: white; -fx-font-weight: bold;" text="AJOUTER"/>
   </HBox>

   <TableView fx:id="tableQuestions" VBox.vgrow="ALWAYS"
              style="-fx-background-color: #16213e; -fx-border-color: #0f3460;">
     <columns>
       <TableColumn fx:id="colText" prefWidth="400.0" text="QUESTION"/>
       <TableColumn fx:id="colActions" prefWidth="150.0" text="ACTIONS"/>
     </columns>
      <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
   </TableView>

   <HBox alignment="CENTER_RIGHT">
      <Button onAction="#handleBack"
              style="-fx-background-color: #0f3460; -fx-text-fill: white; -fx-font-weight: bold;" text="TERMINER" prefWidth="150"/>
   </HBox>
</VBox>
