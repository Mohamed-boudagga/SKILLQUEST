<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="700.0" prefWidth="1000.0"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.gestionTestCertif.GestionCertificationController"
            style="-fx-background-color: #1a1a2e;">
    <SplitPane dividerPositions="0.35"
               AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
               AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <VBox spacing="15.0" style="-fx-background-color: #16213e; -fx-padding: 20;">
            <Button text="← FERMER" onAction="#retourSelection"
                    style="-fx-background-color: transparent; -fx-text-fill: #e94560; -fx-font-weight: bold; -fx-border-color: #e94560; -fx-border-radius: 5; -fx-cursor: hand;"/>
            <Label text="Gestion des Certifications"
                   style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Separator/>
            <Label text="Titre" style="-fx-text-fill: #a8a8b3;"/>
            <TextField fx:id="tfTitle" promptText="Ex: Java Expert"
                       style="-fx-background-color: #0f3460; -fx-text-fill: white;"/>
            <Label text="Niveau" style="-fx-text-fill: #a8a8b3;"/>
            <TextField fx:id="tfLevel" promptText="Ex: 1"
                       style="-fx-background-color: #0f3460; -fx-text-fill: white;"/>
            <Label text="Description" style="-fx-text-fill: #a8a8b3;"/>
            <TextArea fx:id="taDescription" prefHeight="80.0" wrapText="true"
                      style="-fx-control-inner-background: #0f3460; -fx-text-fill: white;"/>
            <VBox spacing="10.0" alignment="CENTER">
                <Button text="Ajouter" onAction="#ajouterCertification" maxWidth="Infinity"
                        style="-fx-background-color: #4ade80; -fx-text-fill: #1a1a2e; -fx-font-weight: bold;"/>
                <HBox spacing="10.0">
                    <Button text="Modifier" onAction="#modifierCertification" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                            style="-fx-background-color: #0f3460; -fx-text-fill: white; -fx-font-weight: bold;"/>
                    <Button text="Supprimer" onAction="#supprimerCertification" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                            style="-fx-background-color: #e94560; -fx-text-fill: white; -fx-font-weight: bold;"/>
                </HBox>
                <Button text="Vider" onAction="#clearFields" maxWidth="Infinity"
                        style="-fx-background-color: #a8a8b3; -fx-text-fill: #1a1a2e;"/>
            </VBox>
        </VBox>
        <VBox spacing="10.0" style="-fx-background-color: #1a1a2e; -fx-padding: 10;">
            <Label text="Liste des Certifications"
                   style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <TableView fx:id="tvCertifications" VBox.vgrow="ALWAYS" onMouseClicked="#handleTableSelection"
                       style="-fx-background-color: #16213e;">
                <columns>
                    <TableColumn fx:id="colTitle" text="Titre" prefWidth="200"/>
                    <TableColumn fx:id="colLevel" text="Niveau" prefWidth="80"/>
                    <TableColumn fx:id="colDate" text="Date Obtention" prefWidth="150"/>
                    <TableColumn fx:id="colDesc" text="Description" prefWidth="250"/>
                </columns>
            </TableView>
            <Label fx:id="lbStatus" text="Prêt" style="-fx-text-fill: #a8a8b3;"/>
        </VBox>
    </SplitPane>
</AnchorPane>
